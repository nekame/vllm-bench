+class TestTargetPrefillStateTransition(unittest.TestCase):
+    """Real build paths for the aligned 8192-token prefill boundary."""
+
+    def _build(self, *, depth=7, computed=8192, draft_index=None, is_decode_node=False):
+        builder = make_builder(num_spec=depth, is_decode_node=is_decode_node)
+        builder.mome_block_size = 128
+        builder.kv_cache_spec.block_size = 128
+        common = FakeCommonAttentionMetadata(
+            seq_lens=[computed + depth + 1], query_lens=[depth + 1]
+        )
+        accepted = torch.tensor([1], dtype=torch.int32)
+        prompt = torch.tensor([8192], dtype=torch.int32)
+        if draft_index is None:
+            metadata = builder.build(0, common, num_accepted_tokens=accepted,
+                                     num_prompt_tokens=prompt)
+        else:
+            metadata = builder.build_for_drafting(
+                common, draft_index=draft_index, num_accepted_tokens=accepted,
+                num_prompt_tokens=prompt,
+            )
+        return metadata, accepted
+
+    def test_initial_target_reads_block63_tail_for_depth3_and_depth7(self):
+        for depth in (3, 7):
+            with self.subTest(depth=depth):
+                metadata, original = self._build(depth=depth)
+                self.assertEqual(metadata.num_accepted_tokens.tolist(), [depth + 1])
+                self.assertEqual(metadata.block_idx_last_computed_token.tolist(), [63])
+                self.assertEqual(metadata.block_idx_first_scheduled_token.tolist(), [64])
+                self.assertEqual(metadata.block_idx_last_scheduled_token.tolist(), [64])
+                self.assertEqual(original.tolist(), [1])
+
+    def test_later_target_preserves_verification_count(self):
+        metadata, _ = self._build(computed=8193)
+        self.assertEqual(metadata.num_accepted_tokens.tolist(), [1])
+        self.assertEqual(metadata.block_idx_last_computed_token.tolist(), [64])
+
+    def test_draft_counts_at_prompt_boundary_are_unchanged(self):
+        for draft_index in (0, 1):
+            with self.subTest(draft_index=draft_index):
+                metadata, _ = self._build(draft_index=draft_index)
+                self.assertEqual(metadata.num_accepted_tokens.tolist(), [1])
+                self.assertEqual(metadata.block_idx_last_computed_token.tolist(), [64])
+
+    def test_pd_boundary_is_unchanged(self):
+        metadata, _ = self._build(is_decode_node=True)
+        self.assertEqual(metadata.num_accepted_tokens.tolist(), [1])
+        self.assertEqual(metadata.block_idx_last_computed_token.tolist(), [64])
+
+    def test_target_mask_is_per_request(self):
+        builder = make_builder(num_spec=7)
+        builder.mome_block_size = 128
+        common = FakeCommonAttentionMetadata(
+            seq_lens=[8199, 8200, 8201], query_lens=[8, 8, 8]
+        )
+        metadata = builder.build(
+            0, common, num_accepted_tokens=torch.tensor([1, 1, 1], dtype=torch.int32),
+            num_prompt_tokens=torch.tensor([8192, 8192, 8192], dtype=torch.int32),
+        )
+        self.assertEqual(metadata.num_accepted_tokens.tolist(), [8, 8, 1])
+        self.assertEqual(metadata.block_idx_last_computed_token.tolist(), [63, 63, 64])
+
+
